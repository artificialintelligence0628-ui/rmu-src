# ===== Server =====
PORT=5000
NODE_ENV=development

# PostgreSQL (Neon connection string)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Admin seed (used by npm run seed)
SEED_ADMIN_EMAIL=admin@rmu.edu.gh
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=SRC Admin

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL="RMU SRC <no-reply@rmu.edu.gh>"

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxx
# Public key must also be set on the CLIENT (see client/.env.example) as VITE_PAYSTACK_PUBLIC_KEY

# Client URL (used for CORS + email links)
CLIENT_URL=http://localhost:5173

# ===== Client (Vite) =====
# These go in client/.env — listed here for reference
# VITE_API_URL=http://localhost:5000/api
# VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxx
